{
  "name": "splat-agent",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Splat AI assistant worker: Cloudflare Workers + Durable Objects + Workers AI, authorized through Supabase RLS.",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "check": "tsc --noEmit",
    "cf-typegen": "wrangler types ./worker-configuration.d.ts --strict-vars false",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate:config": "wrangler deploy --dry-run --outdir=/tmp/splatt-agent-dryrun",
    "mock:supabase": "node scripts/mock-supabase.mjs"
  },
  "dependencies": {
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "typescript": "^5.8.3",
    "vitest": "^3.2.4",
    "wrangler": "^4.16.0"
  }
}
